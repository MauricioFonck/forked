{
  "$defs": {
    "AdapterRecord": {
      "properties": {
        "capture_points": {
          "items": {
            "type": "string"
          },
          "title": "Capture Points",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "AdapterRecord",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "recording",
        "completed",
        "failed",
        "incomplete"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "description": "Content of ``run.json``.",
  "properties": {
    "adapter": {
      "$ref": "#/$defs/AdapterRecord"
    },
    "environment": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Environment",
      "type": "object"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "next_sequence": {
      "minimum": 0,
      "title": "Next Sequence",
      "type": "integer"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "status",
    "started_at",
    "next_sequence",
    "adapter",
    "environment"
  ],
  "title": "RunRecord",
  "type": "object"
}
